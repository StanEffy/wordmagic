# ==============================================================================
# WordMagic Sync Server Environment Configuration
# Copy this file to `.env` in the server/ directory to configure your server.
# ==============================================================================

# Port to listen on (Default: 8080)
PORT=8080

# Secret authorization key for clients to connect (Leave empty for open local network)
WORDMAGIC_KEY=your_secret_sync_key_here

# SQLite Database path
WORDMAGIC_DB=wordmagic_server.db
